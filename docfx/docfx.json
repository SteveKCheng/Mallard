{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../",
          "files": [
            "Mallard/Mallard.csproj"
          ]
        }
      ],
      "properties": {
        "TargetFramework": "net10.0",
        "LangVersion": "preview"
      },
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appName": "Mallard",
      "_appTitle": "Mallard",
      "_enableSearch": true,
      "pdf": false,
      "_appFooter": "<span>Mallard &mdash; memory-safe C# bindings for DuckDB</span>",
      "_disableContribution": false,
      "_appLogoPath": "images/mallard.png"
    }
  }
}